# Spotify Web API credentials. Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# ISO 3166-1 alpha-2 market used by Client Credentials requests.
SPOTIFY_MARKET=US

# Optional fallback lyrics provider.
GENIUS_ACCESS_TOKEN=

# Optional overrides. Defaults use the local pipeline virtual environment when available.
PYTHON_BIN=
YT_DLP_BIN=
